# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
firebase-debug.log
firebase-debug.*.log

# local env files - every variant, except the example we ship
.env*.local
.env
.env*
!.env.example

# credentials and service accounts (Firebase, Google Cloud, etc.)
# These files contain private keys. Never commit them.
*credentials*.json
*service-account*.json
serviceAccount*.json
*-service-account*.json
gcloud-*.json

# private keys and certificates
id_rsa*
id_ed25519*
id_ecdsa*
id_dsa*
*_rsa
*.key
*.p12
*.pfx
*.jks
*.keystore

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.claude/ab-testing/node_modules/

# MCP configuration (should be global, not in workspace)
.cursor/mcp-servers.json
.cursor/mcp.json

# Claude local settings (user-specific)
.claude/settings.local.json

# Local gstack artifacts (security reports, analytics)
.gstack/
